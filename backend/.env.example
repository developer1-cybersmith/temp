PORT=3005
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=catalog-images
FRONTEND_URL=http://localhost:3003
NODE_ENV=development
OWNER_EMAILS=loyamahesh3@gmail.com

# ── AI (GitHub Models was retired 2026-07-30 — see PROJECT_HANDOFF.md gotcha #10) ──
# Text generation (analysis/reply/summary/follow-up): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Vision — car-photo identification, Groq has no vision model: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Embeddings — RAG/catalog search: https://jina.ai/embeddings
JINA_API_KEY=your_jina_api_key_here

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────
# App Secret: Meta Developer Console → Your App → App Settings → Basic
META_APP_SECRET=your_app_secret_here
# Verify Token: any random string you choose, paste same in Meta webhook config
META_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_here
# From Meta Developer Console → WhatsApp → API Setup
META_PHONE_NUMBER_ID=your_phone_number_id
META_WABA_ID=your_waba_id
# System User Token (permanent): Meta Business Suite → System Users
META_SYSTEM_USER_TOKEN=your_permanent_system_user_token_here

# ── Voice Transcription (Groq Whisper, same GROQ_API_KEY as above) ────
# ── Voice Reply / TTS fallback (OpenAI) ───────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
